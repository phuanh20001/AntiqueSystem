NODE_ENV=development
PORT=5000

# Database
# Provide your own MongoDB Atlas connection string
MONGO_URI=

# Auth
# Use a long random string (32+ chars)
JWT_SECRET=

# Blockchain / deployment
# Alchemy/Infura RPC URL for Sepolia (or your target network)
ALCHEMY_SEPOLIA_URL=

# NEVER commit real private keys to git.
# Each dev should use their own key (or a shared dev key stored securely outside git).
DEPLOYER_PRIVATE_KEY=

# Deployed contract address (optional; set after deployment)
CONTRACT_ADDRESS=
